  "zxing": {
    "try_rotate": false,
    "try_downscale": false,
    "try_invert": false
  },
  "ladder": {
    "rungs": [
      "raw",
      "gray",
      "binarize",
      "sharpen",
      "denoise",
      "deskew",
      "multiscale"
    ],
    "accept_formats": [
      "EAN13",
      "EAN8",
      "UPCA"
    ]
  }
}
